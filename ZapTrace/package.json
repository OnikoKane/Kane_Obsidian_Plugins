{
  "name": "zaptrace",
  "version": "0.1.0",
  "description": "ZapTrace：把笔记里的数学题卡变成可练、可评分、可排期的 Obsidian 插件（状态只写本地 data.json）",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "math",
    "spaced-repetition",
    "flashcards"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.30",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.2",
    "obsidian": "^1.5.12",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5"
  }
}
